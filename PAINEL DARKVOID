        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.TextColor3 = Theme.Text
        Label.Font = Enum.Font.Gotham
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
        Label.Parent = ToggleFrame

        local Indicator = Instance.new("Frame")
        Indicator.Size = UDim2.new(0, 40, 0, 20)
        Indicator.Position = UDim2.new(1, -55, 0.5, -10)
        Indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        Indicator.Parent = ToggleFrame
        Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 16, 0, 16)
        Dot.Position = UDim2.new(0, 2, 0.5, -8)
        Dot.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
        Dot.Parent = Indicator
        Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

        -- Sincronização Inicial (Resolve o bug de vir ativado)
        local currentState = getgenv().DZ_Config[category][configKey]
        if currentState then
            Dot.Position = UDim2.new(0, 22, 0.5, -8)
            Dot.BackgroundColor3 = Theme.Accent
        end

        ToggleFrame.MouseButton1Click:Connect(function()
            local newState = not getgenv().DZ_Config[category][configKey]
            getgenv().DZ_Config[category][configKey] = newState
            
            TweenService:Create(Dot, TweenInfo.new(0.2), {
                Position = newState and UDim2.new(0, 22, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
                BackgroundColor3 = newState and Theme.Accent or Color3.fromRGB(100, 100, 120)
            }):Play()
        end)
    end

    CreateTabBtn("VISIBILIDADE", Pages.ESP)
    CreateTabBtn("COMBATE", Pages.Combat)

    CreateToggle(Pages.ESP, "ESP Innocent", "Inno", "ESP")
    CreateToggle(Pages.ESP, "ESP Sheriff", "Sheriff", "ESP")
    CreateToggle(Pages.ESP, "ESP Murderer", "Murder", "ESP")
    CreateToggle(Pages.ESP, "ESP Gun", "Gun", "ESP")
    CreateToggle(Pages.ESP, "Mostrar Nomes", "Names", "ESP")
    
    CreateToggle(Pages.Combat, "Silent Aim (Void)", "SilentAim", "Combat")
    CreateToggle(Pages.Combat, "Auto Get Gun", "AutoGun", "Combat")

    Pages.ESP.Visible = true
    UI_Lib.MakeDraggable(MainFrame)
end

