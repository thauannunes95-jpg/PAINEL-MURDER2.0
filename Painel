-- Utilitário de Segurança para Parent
local function SafeParent(gui)
    pcall(function()
        gui.Parent = game:GetService("CoreGui")
    end)
    if not gui.Parent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- Utilitário para Arrastar (Versão Estável)
local function MakeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging and dragInput and dragStart and startPos then
            local delta = dragInput.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Lógica de FOV
local function GetBestTarget()
    local closest = nil
    local shortestDistance = math.huge
    local isMurderer = false

    -- Verifica se o LocalPlayer é o Murderer (tem faca)
    local myChar = LocalPlayer.Character
    if myChar and myChar:FindFirstChild("Knife") then
        isMurderer = true
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
            
            if not isMurderer then
                -- Se eu não sou murder, priorizo achar o Murderer
                if player.Character:FindFirstChild("Knife") then
                    return player
                end
            end

            if dist < shortestDistance then
                closest = player
                shortestDistance = dist
            end
        end
    end
    return closest
end

-- Aimbot Hook
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if not checkcaller() and method == "FireServer" and getgenv().DZ_AimSaliente then
        local eventName = self.Name:lower()
        if eventName:find("shoot") or eventName:find("fire") or eventName:find("throw") or eventName:find("attack") then
            local target = GetBestTarget()
            if target and target.Character and target.Character:FindFirstChild("Head") then
                args[1] = target.Character.Head.Position
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

