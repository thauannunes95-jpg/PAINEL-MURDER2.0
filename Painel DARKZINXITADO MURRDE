        tracer.AlwaysOnTop = true
        tracer.Parent = char
        
        ESP_Objects[player] = {Highlight = highlight, Label = label, Tracer = tracer}
    end
    
    player.CharacterAdded:Connect(Setup)
    if player.Character then Setup(player.Character) end
end

-- Loop de Atualização do ESP
RunService.Heartbeat:Connect(function()
    for player, obj in pairs(ESP_Objects) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local role = GetPlayerRole(player)
            local enabled = false
            local color = Color3.new(1, 1, 1)
            
            if role == "Murder" and getgenv().DZ_Config.ESP.Murder then enabled = true color = Theme.Murder
            elseif role == "Sheriff" and getgenv().DZ_Config.ESP.Sheriff then enabled = true color = Theme.Sheriff
            elseif role == "Innocent" and getgenv().DZ_Config.ESP.Inno then enabled = true color = Theme.Innocent end
            
            obj.Highlight.Enabled = enabled
            obj.Highlight.FillColor = color
            obj.Highlight.OutlineColor = Color3.new(1, 1, 1)
            
            -- Atualiza Label
            if getgenv().DZ_Config.ESP.Names then
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude)
                obj.Label.Text = string.format("%s [%s] - %dm", player.Name, role, dist)
                obj.Label.TextColor3 = color
                obj.Label.Visible = enabled
            else
                obj.Label.Visible = false
            end
            
            -- Atualiza Tracer
            if getgenv().DZ_Config.ESP.Tracer and enabled then
                obj.Tracer.Visible = true
                obj.Tracer.Color3 = color
                obj.Tracer.Adornee = player.Character.HumanoidRootPart
                local startPos = Camera.CFrame.Position
                local endPos = player.Character.HumanoidRootPart.Position
                obj.Tracer.Length = (startPos - endPos).Magnitude
                obj.Tracer.CFrame = CFrame.new(startPos, endPos)
            else
                obj.Tracer.Visible = false
            end
        else
            ESP_Objects[player] = nil
        end
    end
end)

