-- ESP System
local function ApplyESP(player)
    local function Setup(char)
        local highlight = Instance.new("Highlight")
        highlight.Name = "DZ_ESP"
        highlight.Parent = char
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if not char or not char.Parent then conn:Disconnect() return end
            local role = "Innocent"
            if char:FindFirstChild("Knife") or (player.Backpack and player.Backpack:FindFirstChild("Knife")) then role = "Murder"
            elseif char:FindFirstChild("Gun") or (player.Backpack and player.Backpack:FindFirstChild("Gun")) then role = "Sheriff" end
            
            local enabled = false
            local color = Color3.new(1,1,1)
            if role == "Murder" and getgenv().DZ_ESP_Murder then enabled = true color = Theme.Murder
            elseif role == "Sheriff" and getgenv().DZ_ESP_Sheriff then enabled = true color = Theme.Sheriff
            elseif role == "Innocent" and getgenv().DZ_ESP_Inno then enabled = true color = Theme.Innocent end
            highlight.Enabled = enabled
            highlight.FillColor = color
        end)
    end
    player.CharacterAdded:Connect(Setup)
    if player.Character then Setup(player.Character) end
end

