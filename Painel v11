local flySpeed = 50
RunService.RenderStepped:Connect(function()
    if getgenv().DZ_Fly and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local root = LocalPlayer.Character.HumanoidRootPart
        local moveDir = Vector3.new(0,0,0)
